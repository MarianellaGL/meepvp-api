<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#0b0f19;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e5e7eb;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#0b0f19;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:480px;background:#111827;border:1px solid #1f2937;border-radius:12px;padding:32px;">
            <tr><td style="font-size:20px;font-weight:600;padding-bottom:16px;">Verify your email</td></tr>
            <tr><td style="font-size:15px;line-height:1.5;padding-bottom:24px;">Hi {{if .Name}}{{.Name}}{{else}}there{{end}}, welcome to {{.AppName}}. Please confirm your email address.</td></tr>
            <tr><td align="center" style="padding-bottom:24px;">
              <a href="{{.Link}}" style="display:inline-block;background:#22d3ee;color:#0b0f19;text-decoration:none;font-weight:600;padding:12px 24px;border-radius:8px;">Verify email</a>
            </td></tr>
            <tr><td style="font-size:13px;line-height:1.5;color:#9ca3af;padding-bottom:8px;">Or paste this link into your browser:</td></tr>
            <tr><td style="font-size:13px;line-height:1.5;word-break:break-all;"><a href="{{.Link}}" style="color:#22d3ee;">{{.Link}}</a></td></tr>
            <tr><td style="font-size:13px;line-height:1.5;color:#9ca3af;padding-top:24px;">The link expires in {{.ExpiresIn}}. If you did not create an account, you can ignore this email.</td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
