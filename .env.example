# Keep real values in .env. Never commit that file.
PORT=8080
BGG_API_TOKEN=replace-with-your-token
# Optional: AI proposals for OCR and game search. Keep the real key only in .env or Render.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The Render image uses AI_PROVIDER=codex-worker; set a separate restricted key in Render.
# CODEX_API_KEY=
# For local CLI use only:
# AI_PROVIDER=codex-cli
# AI_CODEX_HOME=/path/to/dedicated/codex/home
DATABASE_URL=postgres://tablescore:tablescore@localhost:5432/tablescore?sslmode=disable

# Required when config.yaml is absent. Generate a persistent secret with openssl rand -base64 64.
AUTH_JWT_SECRET=change-me-to-a-random-64-char-string
